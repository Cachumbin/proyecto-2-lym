method main {
  val a: Int = 7
  val b: Int = 2
  println("suma ${a + b}")
  println("division ${a / b}")
  println("modulo ${a % b}")
  println("potencia ${b ** 10}")
  println("decimal ${a + 0.5}")
  println("precedencia ${(1 + 2) * 3}")
  println("negado ${neg a}")
  println("comparacion ${a > b and b >= 2}")
}
